{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "core-born",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coreborn-waitlist",
      "database_id": "2b0c340b-074c-4f25-8770-dc181126c822"
    }
  ]
}
